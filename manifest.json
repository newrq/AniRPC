{
  "manifest_version": 3,
  "name": "AniRPC — Discord Presence",
  "version": "1.0.0",
  "description": "Discord Rich Presence для yummyani, yummyanime, animego, jut.su",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:47201/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "AniRPC"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ru.yummyani.me/*",
        "*://yummyanime.tv/*",
        "*://animego.me/*",
        "*://jut.su/*",
        "*://hianimes.se/*",
        "*://*.miruro.tv/*"
      ],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
